{
  "name": "@peter.naydenov/walk",
  "description": "Deep copy with fine control during the process. Can be used also as a deep forEach function",
  "version": "7.0.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./src/main.js",
  "type": "module",
  "types": "./types/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      },
      "require": {
        "types": "./dist/walk.d.cts",
        "default": "./dist/walk.cjs"
      },
      "types": "./types/main.d.ts",
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build": "vite build",
    "postbuild": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/walk.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "browserslist": "> 2%, not dead",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
